# Meridian Retail production runtime configuration.
#
# Copy this template to:
#   /opt/meridian/config/.env.production
#
# Never commit the real production file.

DB_NAME=meridian_db
DB_USER=meridian
DB_PASSWORD=replace-with-a-strong-random-production-password

JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRY_MINUTES=60
