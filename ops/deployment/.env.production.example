# Meridian Retail production runtime configuration.
#
# Copy this template to:
#   /opt/meridian/config/.env.production
#
# Never commit the real production file.

DB_NAME=meridian_db

# Administrative PostgreSQL identity.
# Existing production keeps the current bootstrap/database-owner role.
DB_ADMIN_USER=meridian
DB_ADMIN_PASSWORD=replace-with-a-strong-random-admin-password

# Restricted application runtime identities.
AUTH_DB_USER=meridian_auth_app
AUTH_DB_PASSWORD=replace-with-a-strong-random-auth-password

CATALOG_DB_USER=meridian_catalog_app
CATALOG_DB_PASSWORD=replace-with-a-strong-random-catalog-password

ORDERS_DB_USER=meridian_orders_app
ORDERS_DB_PASSWORD=replace-with-a-strong-random-orders-password

JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRY_MINUTES=60